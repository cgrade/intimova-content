{
  // Intimova's private admin page (admin.intimova.ng). Deploy with: cd admin && npx wrangler deploy
  // Then turn on Cloudflare Access for this Worker (admin/README.md). Without Access it serves nothing.
  "name": "intimova-admin",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "routes": [{ "pattern": "admin.intimova.ng", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs before every file, so the Access check covers the page itself, not only the API.
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_REPO": "cgrade/intimova-content",
    "MEDIA_BASE": "https://media.intimova.ng"
  },
  "observability": { "enabled": true }
}
