// The posting alarm (see worker.js). Deploy from this folder: npx wrangler deploy
{
  "name": "intimova-alarm",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  // No public address: the Worker only runs on its schedule.
  "workers_dev": false,
  "triggers": {
    // Cron is in UTC (Lagos is UTC+1). Cloudflare's free plan allows 5 per account; these are 2.
    "crons": [
      // Publisher: every 10 minutes at :08, :18 ... :58, from 06:08 to 22:58 Lagos time.
      // GitHub's own schedule runs it at :03, :13 ... as a backup, so the two clocks don't collide.
      "1,11,21,31,41,51 5-21 * * *",
      // Results and prices: Saturdays at 06:06 and 08:06 Lagos, before the 09:33 draft run.
      // Must match INSIGHTS_CRON below exactly.
      "6 5,7 * * 6"
    ]
  },
  "vars": {
    "GITHUB_REPO": "cgrade/intimova-content",
    "WORKFLOW": "publish.yml",
    "INSIGHTS_CRON": "6 5,7 * * 6"
  },
  "observability": { "enabled": true }
}
